# Serveur
PORT=3000
NODE_ENV=development

# Domaine canonique (production) : redirige HTTPS et l'hôte brut d'AlwaysData vers ce domaine.
CANONICAL_HOST=
# URL publique du site, utilisée dans les liens des e-mails (ex. https://lectype.app).
BASE_URL=http://localhost:3000

# Session : une longue chaîne aléatoire (openssl rand -hex 32). Obligatoire en production.
SESSION_SECRET=

# Base de données : dossier des fichiers SQLite (par défaut ./data).
DATA_DIR=

# E-mails via Brevo. Sans clé, les e-mails sont écrits dans la console (développement).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Lectype

# Mentions légales (affichées sur /legal). À remplir avant la mise en ligne.
LEGAL_PUBLISHER=
LEGAL_CONTACT_EMAIL=
LEGAL_HOST=

# Lien du bouton « Télécharger pour Mac » (par défaut : la dernière Release GitHub de Lectype_web).
MAC_DOWNLOAD_URL=
