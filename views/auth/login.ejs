<%- include('../partials/head', { title: t('auth.login.title') + ' — Lectype' }) %>
<%- include('../partials/header') %>
<main id="main" class="auth">
  <h1><%= t('auth.login.title') %></h1>
  <% if (problem) { %><p class="problem" role="alert"><%= t(problem) %></p><% } %>
  <% if (typeof resend !== 'undefined' && resend) { %>
    <form method="post" action="/verify/resend">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="email" value="<%= values.email %>">
      <button class="button" type="submit"><%= t('auth.login.resend') %></button>
    </form>
  <% } %>
  <form method="post" action="/login" class="auth-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('field', { label: 'auth.email', name: 'email', type: 'email', autocomplete: 'username', value: values.email, maxlength: 254 }) %>
    <%- include('field', { label: 'auth.password', name: 'password', type: 'password', autocomplete: 'current-password' }) %>
    <label class="choice"><input type="checkbox" name="remember"> <%= t('auth.login.remember') %></label>
    <button class="button primary" type="submit"><%= t('auth.login.submit') %></button>
  </form>
  <p><a href="/forgot"><%= t('auth.login.forgot') %></a></p>
  <p><%= t('auth.login.noAccount') %> <a href="/signup"><%= t('nav.signup') %></a></p>
</main>
<%- include('../partials/footer') %>
