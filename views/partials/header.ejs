<header class="site-header">
  <a class="brand" href="/"><img src="/img/brand-mark.png" alt="" width="32" height="32"> Lectype</a>
  <nav aria-label="Navigation">
    <a href="/app/library"><%= t('nav.library') %></a>
    <a href="/app/learn"><%= t('nav.learn') %></a>
    <a href="/app/stories"><%= t('nav.stories') %></a>
    <a href="/app/stats"><%= t('nav.stats') %></a>
    <a href="/app/settings"><%= t('nav.settings') %></a>
    <% if (currentUser) { %>
      <a href="/account"><%= currentUser.firstName %></a>
      <form method="post" action="/logout" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="link"><%= t('nav.logout') %></button>
      </form>
    <% } else { %>
      <a href="/login"><%= t('nav.login') %></a>
      <a class="button" href="/signup"><%= t('nav.signup') %></a>
    <% } %>
  </nav>
</header>
