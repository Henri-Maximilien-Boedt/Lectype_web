<!doctype html>
<html lang="<%= lang %>" data-theme="day">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= t('site.tagline') %>">
  <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/app.css">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <% if (currentUser) { %><meta name="lectype-user" content="<%= currentUser.id %>"><% } %>
  <script src="/js/theme-boot.js"></script>
  <script type="module" src="/js/account-sync.js"></script>
</head>
<body>
<a class="skip-link" href="#main"><%= t('site.skip') %></a>
