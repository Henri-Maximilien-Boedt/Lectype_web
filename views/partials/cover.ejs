<% const clothColors = ['#2b4c7e', '#8a3324', '#2f5d50', '#5b3f8a', '#7a5c1e', '#3d4a5c', '#6e2f4a']; %>
<% const clothIndex = String(item.id || item.title).split('').reduce(function (sum, character) { return sum + character.charCodeAt(0); }, 0) % clothColors.length; %>
<% if (item.cover) { %>
  <img class="cover" src="/content/covers/<%= item.cover %>" alt="" loading="lazy">
<% } else { %>
  <span class="cover cloth cloth-<%= clothIndex %>" aria-hidden="true">
    <span class="cloth-title"><%= item.title %></span>
    <span class="cloth-rule"></span>
    <% if (item.author) { %><span class="cloth-author"><%= item.author %></span><% } %>
  </span>
<% } %>
